# Port for Express API server
PORT=5000

# PostgreSQL connection string (Local or Railway internal/external)
DATABASE_URL=postgresql://postgres:password@localhost:5432/knowar_db

# Secret key for signing JWT tokens
JWT_SECRET=super_secret_jwt_key_change_in_production

# Google Gemini API key for automated question generation
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Optional: Primary LLM Model (defaults to gemini-3.5-flash-lite with automatic multi-model failover)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: SMTP Configuration for Forgot-Password OTP Emails
# (If omitted locally, Nodemailer Ethereal & server console OTP output are used automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Knowledge Warrior Security <no-reply@knowledgewarrior.com>"
