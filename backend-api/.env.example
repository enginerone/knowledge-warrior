# Runtime environment: use "development" locally and "production" on Railway
NODE_ENV=development

# Port for Express API server (Railway injects PORT automatically in cloud production)
PORT=5000

# PostgreSQL connection string
# Local testing uses your local PostgreSQL instance (knowar_db)
# Cloud production on Railway uses ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/knowar_db

# Allowed browser origins (comma-separated)
# Leave as http://localhost:5173 locally; on Railway set this to your Cloudflare Pages Admin Portal HTTPS URL
CORS_ORIGIN=http://localhost:5173

# Secret key for signing JWT tokens (use a distinct secret on Railway so local tokens never mix with cloud)
JWT_SECRET=super_secret_jwt_key_change_in_production

# Optional initial admin credentials used on first database seed (username + password only)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=AdminPassword123!

# Google Gemini API key for automated question generation and subject replenishment
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Optional: Primary LLM Model (defaults to gemini-3.5-flash-lite with automatic multi-model failover)
GEMINI_MODEL=gemini-3.5-flash-lite

# Forgot-Password Player OTP Email Delivery (choose Brevo HTTPS API, Resend HTTPS API, or Gmail/SMTP)
# Option A (Recommended for Railway Cloud): Brevo HTTPS Transactional API (port 443, works without custom domain)
BREVO_API_KEY=
# Option B: Resend HTTPS API (port 443, requires verified sender domain for external recipients)
RESEND_API_KEY=
# Shared sender identity for Brevo, Resend, or SMTP
EMAIL_FROM="Knowledge Warrior Security <your_verified_sender@gmail.com>"

# Option C: Gmail App Password or Standard SMTP (falls back to Ethereal test inbox only in local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="Knowledge Warrior Security <your_email@gmail.com>"

